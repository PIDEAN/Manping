+// Free plane sampling is only valid when no stage needs a source-sized RGB
+// texture. Keep the general pipeline for hooks, subtitles, transforms and HDR.
+// This matches libplacebo's SAMPLER_DIRECT/!need_fbo case, including skipping
+// linear/sigmoid conversion that otherwise introduces a materialized RGB FBO.
+static bool can_sample_planes_directly(struct gl_video *p)
+{
+    if (p->num_tex_hooks || p->num_user_textures || p->has_alpha ||
+        p->opts.interpolation || p->opts.blend_subs != BLEND_SUBS_NO ||
+        p->pass_compute.active || p->use_linear ||
+        p->sdr_policy.source_is_hdr ||
+        p->image_params.rotate ||
+        p->src_rect.x0 || p->src_rect.y0 ||
+        p->src_rect.x1 != p->image_params.w ||
+        p->src_rect.y1 != p->image_params.h ||
+        p->image_params.w % 2 || p->image_params.h % 2 ||
+        !gl_transform_eq(p->texture_offset, identity_trans))
+        return false;
+
+    for (int i = SCALER_SCALE; i <= SCALER_CSCALE; i++) {
+        int filter = p->opts.scaler[i].kernel.function;
+        if (filter == SCALER_INHERIT)
+            filter = p->opts.scaler[SCALER_SCALE].kernel.function;
+        if (filter != SCALER_BILINEAR)
+            return false;
+    }
+
+    // Subsampling must divide the source exactly. pass_read_video has already
+    // resolved chroma location, range and plane alignment in the bound UVs.
+    if (p->image_params.w % p->ra_format.chroma_w ||
+        p->image_params.h % p->ra_format.chroma_h)
+        return false;
+    for (int i = 0; i < p->num_pass_imgs; i++) {
+        const struct image *img = &p->pass_imgs[i];
+        if (!img->tex || img->transform.m[0][1] || img->transform.m[1][0] ||
+            img->transform.m[0][0] <= 0 || img->transform.m[1][1] <= 0)
+            return false;
+    }
+    return p->num_pass_imgs > 0;
+}
