+// Use libplacebo's metadata inference and BT.1886 equations (v7.360.1,
+// src/colorspace.c and src/shaders/colorspace.c). Support only mappings that
+// need neither black-point adaptation, tone mapping, nor gamut compression.
+static struct sdr_black_policy make_sdr_black_policy(struct gl_video *p,
+                                                    const struct pl_color_space *fbo,
+                                                    const struct mp_image *frame)
+{
+    struct sdr_black_policy policy = {.contrast = p->opts.target_contrast};
+#define SDR_FALLBACK(text) do { policy.reason = text; return policy; } while (0)
+    if (!frame)
+        SDR_FALLBACK("no current video frame");
+    // gl_video_config compares only static params. Read per-frame HDR metadata
+    // here without changing the legacy HDR pipeline's configured parameters.
+    struct pl_color_space src = p->image_params.color;
+    src.hdr = frame->params.color.hdr;
+    policy.source_is_hdr = pl_color_space_is_hdr(&src);
+    if (src.transfer != PL_COLOR_TRC_BT_1886 ||
+        p->image_params.light != MP_CSP_LIGHT_DISPLAY || policy.source_is_hdr)
+        SDR_FALLBACK("source is not display-referred SDR BT.1886");
+    if (p->dumb_mode || p->has_alpha || p->use_lut_3d || p->opts.interpolation)
+        SDR_FALLBACK("alpha, ICC LUT, interpolation or dumb mode needs legacy pipeline");
+    if (p->opts.target_gamut || p->opts.tone_map.inverse ||
+        p->opts.tone_map.gamut_mode == GAMUT_WARN)
+        SDR_FALLBACK("explicit gamut or inverse tone mapping needs legacy pipeline");
+
+    struct pl_color_space dst = {
+        .transfer = p->opts.target_trc ? p->opts.target_trc : fbo->transfer,
+        .primaries = p->opts.target_prim ? p->opts.target_prim : fbo->primaries,
+        .hdr.max_luma = p->opts.target_peak ? p->opts.target_peak : fbo->hdr.max_luma,
+        .hdr.min_luma = fbo->hdr.min_luma,
+    };
+    if (!dst.primaries) {
+        dst.primaries = PL_COLOR_PRIM_BT_709;
+        if (src.primaries == PL_COLOR_PRIM_BT_601_525 ||
+            src.primaries == PL_COLOR_PRIM_BT_601_625)
+            dst.primaries = src.primaries;
+    }
+    if (!dst.transfer)
+        dst.transfer = src.transfer;
+    if (dst.transfer != PL_COLOR_TRC_SRGB && dst.transfer != PL_COLOR_TRC_LINEAR)
+        SDR_FALLBACK("target transfer is neither sRGB nor linear");
+    if (dst.transfer == PL_COLOR_TRC_SRGB &&
+        (src.primaries != dst.primaries || pl_color_space_is_hdr(&dst)))
+        SDR_FALLBACK("sRGB target requires the same SDR primaries");
+    if (dst.transfer == PL_COLOR_TRC_LINEAR &&
+        (src.primaries != PL_COLOR_PRIM_BT_709 ||
+         (dst.primaries != PL_COLOR_PRIM_BT_709 && dst.primaries != PL_COLOR_PRIM_BT_2020)))
+        SDR_FALLBACK("linear target requires BT.709 source and BT.709/BT.2020 destination");
+
+    // Match vo_gpu_next target-contrast: zero is unknown/auto, not zero black.
+    if (p->opts.target_contrast == -1) {
+        dst.hdr.min_luma = 1e-7f;
+    } else if (p->opts.target_contrast > 0) {
+        pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
+            .color = &dst, .metadata = PL_HDR_METADATA_HDR10,
+            .scaling = PL_HDR_NITS, .out_max = &dst.hdr.max_luma));
+        dst.hdr.min_luma = dst.hdr.max_luma / p->opts.target_contrast;
+    }
+    pl_color_space_infer_map(&src, &dst);
+    if ((dst.transfer == PL_COLOR_TRC_SRGB && src.hdr.max_luma != dst.hdr.max_luma) ||
+        src.hdr.max_luma > dst.hdr.max_luma || src.hdr.min_luma != dst.hdr.min_luma)
+        SDR_FALLBACK("source/target require tone or black-point adaptation");
+    if (!pl_raw_primaries_equal(&src.hdr.prim, pl_raw_primaries_get(src.primaries)) ||
+        !pl_raw_primaries_equal(&dst.hdr.prim, pl_raw_primaries_get(dst.primaries)) ||
+        !pl_primaries_superset(&dst.hdr.prim, &src.hdr.prim))
+        SDR_FALLBACK("source/target require gamut mapping");
+
+    float src_min, src_max;
+    pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
+        .color = &src, .metadata = PL_HDR_METADATA_HDR10, .scaling = PL_HDR_NORM,
+        .out_min = &src_min, .out_max = &src_max));
+    pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
+        .color = &dst, .metadata = PL_HDR_METADATA_HDR10, .scaling = PL_HDR_NORM,
+        .out_min = &policy.dst_min, .out_max = &policy.dst_max));
+    if (!(src_max > src_min && policy.dst_max > policy.dst_min &&
+          src_min >= 0 && policy.dst_min >= 0))
+        SDR_FALLBACK("invalid nominal luminance range");
+    float lb = powf(src_min, 1.0f / 2.4f), lw = powf(src_max, 1.0f / 2.4f);
+    policy.a = powf(lw - lb, 2.4f);
+    policy.b = lb / (lw - lb);
+    policy.src = src;
+    policy.dst = dst;
+    policy.enabled = true;
+    policy.reason = "supported";
+    return policy;
+#undef SDR_FALLBACK
+}
+
+static void prepare_sdr_black_policy(struct gl_video *p, const struct pl_color_space *fbo,
+                                     const struct mp_image *frame)
+{
+    struct sdr_black_policy next = make_sdr_black_policy(p, fbo, frame);
+    const struct sdr_black_policy *old = &p->sdr_policy;
+    bool changed = old->enabled != next.enabled || old->contrast != next.contrast ||
+                   old->source_is_hdr != next.source_is_hdr ||
+                   !pl_color_space_equal(&old->src, &next.src) ||
+                   !pl_color_space_equal(&old->dst, &next.dst);
+    if (changed)
+        p->output_tex_valid = false;
+    if (next.enabled) {
+        MP_VERBOSE(p, "shader compatibility: BT.1886 black map src=%g/%g dst=%g/%g nits contrast=%d\n",
+                   next.src.hdr.min_luma, next.src.hdr.max_luma,
+                   next.dst.hdr.min_luma, next.dst.hdr.max_luma, next.contrast);
+    } else {
+        MP_VERBOSE(p, "shader compatibility: legacy color fallback: %s\n", next.reason);
+        if (next.contrast && (changed || !old->reason || strcmp(old->reason, next.reason)))
+            MP_WARN(p, "target-contrast is not applied by legacy renderer: %s\n", next.reason);
+    }
+    p->sdr_policy = next;
+}
+
+static void pass_sdr_linearize(struct gl_video *p)
+{
+    if (!p->sdr_policy.enabled) {
+        pass_linearize(p->sc, p->image_params.color.transfer);
+        return;
+    }
+    pass_describe(p, "metadata BT.1886 EOTF");
+    GLSL(color.rgb = max(color.rgb, vec3(0.0));)
+    gl_sc_uniform_vec2(p->sc, "sdr_eotf", (float[]){p->sdr_policy.a, p->sdr_policy.b});
+    GLSL(color.rgb = sdr_eotf.x * pow(color.rgb + vec3(sdr_eotf.y), vec3(2.4));)
+}
+
+static void pass_sdr_delinearize(struct gl_video *p)
+{
+    if (!p->sdr_policy.enabled) {
+        pass_delinearize(p->sc, p->image_params.color.transfer);
+        return;
+    }
+    pass_describe(p, "metadata BT.1886 inverse EOTF");
+    GLSL(color.rgb = max(color.rgb, vec3(0.0));)
+    gl_sc_uniform_vec2(p->sc, "sdr_eotf", (float[]){p->sdr_policy.a, p->sdr_policy.b});
+    GLSL(color.rgb = pow(color.rgb / sdr_eotf.x, vec3(1.0/2.4)) - vec3(sdr_eotf.y);)
+}
+
+static bool has_scaling_hook(struct gl_video *p, const char *name)
+{
+    for (int i = 0; i < p->num_tex_hooks; i++) {
+        for (int n = 0; n < SHADER_MAX_HOOKS; n++) {
+            const char *stage = p->tex_hooks[i].hook_tex[n];
+            if (stage && !strcmp(stage, name))
+                return true;
+        }
+        for (int n = 0; n < SHADER_MAX_BINDS; n++) {
+            const char *binding = p->tex_hooks[i].bind_tex[n];
+            if (binding && !strcmp(binding, name))
+                return true;
+        }
+    }
+    return false;
+}
