+// The input is either encoded BT.1886 or the policy's absolute linear light.
+// No post-capture correction is involved; this is the actual output shader.
+static bool pass_sdr_black_map(struct gl_video *p, struct pl_color_space *src,
+                               struct pl_color_space *dst, bool osd)
+{
+    const struct sdr_black_policy *policy = &p->sdr_policy;
+    if (osd || !policy->enabled)
+        return false;
+    if (!p->use_linear)
+        pass_sdr_linearize(p);
+    if (policy->src.primaries != policy->dst.primaries) {
+        pl_matrix3x3 m = pl_get_color_mapping_matrix(
+            pl_raw_primaries_get(policy->src.primaries),
+            pl_raw_primaries_get(policy->dst.primaries),
+            PL_INTENT_RELATIVE_COLORIMETRIC);
+        gl_sc_uniform_mat3(p->sc, "sdr_cms_matrix", true, &m.m[0][0]);
+        GLSL(color.rgb = sdr_cms_matrix * color.rgb;)
+    }
+    // Linear targets encode nits / 203, never normalized by target-peak.
+    if (policy->dst.transfer == PL_COLOR_TRC_SRGB) {
+        gl_sc_uniform_vec2(p->sc, "sdr_target_range", (float[]){
+            1.0f / (policy->dst_max - policy->dst_min),
+            -policy->dst_min / (policy->dst_max - policy->dst_min)});
+        GLSL(color.rgb = sdr_target_range.x * color.rgb + vec3(sdr_target_range.y);)
+        GLSL(color.rgb = max(color.rgb, vec3(0.0));)
+        GLSLF("color.rgb = mix(color.rgb * vec3(12.92),\n"
+              "vec3(1.055) * pow(color.rgb, vec3(1.0/2.4)) - vec3(0.055),\n"
+              "%s(lessThanEqual(vec3(0.0031308), color.rgb)));\n",
+              gl_sc_bvec(p->sc, 3));
+        // Bounded SDR encoding, even when the destination attachment is float.
+        // This boundary must not be applied to linear EDR or PQ/HLG.
+        GLSL(color.rgb = clamp(color.rgb, 0.0, 1.0);)
+    }
+    pass_describe(p, "metadata SDR BT.1886 to %s%s",
+                  policy->dst.transfer == PL_COLOR_TRC_LINEAR ? "linear" : "sRGB",
+                  p->use_linear ? " (prelinearized)" : "");
+    *src = policy->src;
+    *dst = policy->dst;
+    return true;
 }
 
